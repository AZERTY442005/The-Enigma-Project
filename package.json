{
  "name": "the-enigma-project",
  "version": "2.0.0",
  "description": "A TypeScript implementation of the Enigma I cipher machine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "crack": "ts-node src/crack.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enoal-Fauchille-Bolle/The-Enigma-Project.git"
  },
  "author": "AZERTY",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Enoal-Fauchille-Bolle/The-Enigma-Project/issues"
  },
  "homepage": "https://github.com/Enoal-Fauchille-Bolle/The-Enigma-Project#readme",
  "keywords": [
    "enigma",
    "cipher",
    "encryption",
    "cryptography",
    "ww2",
    "typescript"
  ],
  "dependencies": {
    "inquirer": "^11.0.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}